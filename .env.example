# Copy this file to .env and adjust. Everything is optional.

# Long random string used to encrypt SSH keys, DB passwords and tokens stored by Switchboard.
# If empty, one is generated into data/app.key (keep that file safe, it is needed to read the secrets).
# Generate one with:  openssl rand -base64 32
APP_KEY=

# Time zone for logs and schedules (cron)
TZ=UTC

# Create the first admin automatically (otherwise use the setup code printed in the logs)
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-this-to-a-long-password

# Set both to true when the dashboard is served over HTTPS through Caddy / Nginx / Cloudflare Tunnel
# (TRUST_PROXY makes the login rate-limit see the real visitor IP; don't set it without a proxy)
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Port inside the container (keep 8080 unless you know why)
# PORT=8080
